{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://fei.io",
          "https://www.fei.io",
          "https://fei-io.pages.dev",
          "http://localhost:8788"
        ],
        "methods": ["GET", "PUT", "HEAD"],
